#!/bin/sh
#
# The rear camera's sensor (ov5693) often does not answer when its driver
# probes it at boot, and atomisp then registers neither camera, since it waits
# for both. Probing it again later succeeds; retry until the driver binds.
#
dev=/sys/bus/i2c/devices/i2c-INT33BE:00
drv=/sys/bus/i2c/drivers/ov5693

[ -e "$dev" ] || exit 0

# Give the driver time to load and to make its own first attempt.
for _ in $(seq 30); do
  [ -d "$drv" ] && break
  sleep 1
done
sleep 2

for _ in 1 2 3 4 5; do
  [ -e "$dev/driver" ] && exit 0
  echo i2c-INT33BE:00 >"$drv/bind" 2>/dev/null
  sleep 2
done
[ -e "$dev/driver" ] && exit 0
echo "the rear camera sensor did not bind" >&2
exit 1
