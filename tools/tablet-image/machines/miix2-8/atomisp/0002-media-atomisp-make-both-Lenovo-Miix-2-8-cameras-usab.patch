index c31a81d64..b14c5df3b 100644
--- a/drivers/staging/media/atomisp/i2c/atomisp-ov2722.c
+++ b/drivers/staging/media/atomisp/i2c/atomisp-ov2722.c
@@ -661,7 +661,7 @@ static int ov2722_set_fmt(struct v4l2_subdev *sd,
