 drivers/staging/media/atomisp/i2c/ov2722.h    | 192 +++++++++---------
 .../staging/media/atomisp/pci/atomisp_cmd.c   |  13 +-
 .../media/atomisp/pci/atomisp_gmin_platform.c |  14 ++
 .../staging/media/atomisp/pci/atomisp_ioctl.c |   3 +-
 .../isp/kernels/wb/wb_1.0/ia_css_wb.host.c    |   8 +-
 6 files changed, 130 insertions(+), 102 deletions(-)

