search --no-floppy --fs-uuid --set=root @ROOT_UUID@

# The menu stays hidden. It shows once after a boot-menu request, and after a
# boot that never reached graphical.target (grub-boot-ok.service clears
# boot_pending), then defaulting to the previous kernel; holding Shift on a
# USB keyboard shows it too.
set default=0
set timeout_style=hidden
set timeout=0
if [ -f /boot/grub/grubenv ]; then
    load_env -f /boot/grub/grubenv boot_pending boot_menu
    if [ "$boot_pending" = 1 ]; then
        set default=1
        set boot_menu=1
    fi
    if [ "$boot_menu" = 1 ]; then
        set timeout_style=menu
        set timeout=10
    fi
    set boot_pending=1
    set boot_menu=0
    save_env -f /boot/grub/grubenv boot_pending boot_menu
fi
if keystatus --shift; then
    set timeout_style=menu
    set timeout=-1
fi

menuentry 'Debian' {
    linux /vmlinuz root=UUID=@ROOT_UUID@ ro quiet @CMDLINE@
    initrd /initrd.img
}

menuentry 'Debian (previous kernel)' {
    linux /vmlinuz.old root=UUID=@ROOT_UUID@ ro quiet @CMDLINE@
    initrd /initrd.img.old
}
