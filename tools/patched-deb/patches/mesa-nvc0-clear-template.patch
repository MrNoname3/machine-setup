Description: Build a real nvc0 surface for a clear of a template
 As on nv50, clear_render_target and clear_depth_stencil get a plain
 pipe_surface template, but nvc0 read it as its own nv50_surface, so the
 offset, size and layer count came from past the end of the template.
 VA-API clears every new video surface that way, and PGRAPH trapped with
 RT_WIDTH_OVERRUN when a browser started decoding. Build the surface from
 the template.
diff --git a/src/gallium/drivers/nouveau/nvc0/nvc0_surface.c b/src/gallium/drivers/nouveau/nvc0/nvc0_surface.c
index 2609a9a..3460318 100644
--- a/src/gallium/drivers/nouveau/nvc0/nvc0_surface.c
+++ b/src/gallium/drivers/nouveau/nvc0/nvc0_surface.c
@@ -295,15 +295,20 @@ nvc0_clear_render_target(struct pipe_context *pipe,
 {
    struct nvc0_context *nvc0 = nvc0_context(pipe);
    struct nouveau_pushbuf *push = nvc0->base.pushbuf;
-   struct nv50_surface *sf = nv50_surface(dst);
-   struct nv04_resource *res = nv04_resource(sf->base.texture);
+   /* dst may be a plain template, without nv50_surface's fields. */
+   struct pipe_surface *ps = nvc0_miptree_surface_new(pipe, dst->texture, dst);
+   struct nv50_surface *sf = nv50_surface(ps);
+   struct nv04_resource *res = nv04_resource(dst->texture);
    unsigned z;
 
    assert(dst->texture->target != PIPE_BUFFER);
 
-   if (!PUSH_SPACE(push, 32 + sf->depth))
+   if (!ps)
       return;
 
+   if (!PUSH_SPACE(push, 32 + sf->depth))
+      goto out;
+
    PUSH_REF1 (push, res->bo, res->domain | NOUVEAU_BO_WR);
 
    BEGIN_NVC0(push, NVC0_3D(CLEAR_COLOR(0)), 4);
@@ -367,6 +372,8 @@ nvc0_clear_render_target(struct pipe_context *pipe,
       IMMED_NVC0(push, NVC0_3D(COND_MODE), nvc0->cond_condmode);
 
    nvc0->dirty_3d |= NVC0_NEW_3D_FRAMEBUFFER;
+out:
+   nv50_surface_destroy(pipe, ps);
 }
 
 static void
@@ -632,16 +639,21 @@ nvc0_clear_depth_stencil(struct pipe_context *pipe,
    struct nvc0_context *nvc0 = nvc0_context(pipe);
    struct nouveau_pushbuf *push = nvc0->base.pushbuf;
    struct nv50_miptree *mt = nv50_miptree(dst->texture);
-   struct nv50_surface *sf = nv50_surface(dst);
+   /* dst may be a plain template, without nv50_surface's fields. */
+   struct pipe_surface *ps = nvc0_miptree_surface_new(pipe, dst->texture, dst);
+   struct nv50_surface *sf = nv50_surface(ps);
    uint32_t mode = 0;
    int unk = mt->base.base.target == PIPE_TEXTURE_2D;
    unsigned z;
 
    assert(dst->texture->target != PIPE_BUFFER);
 
-   if (!PUSH_SPACE(push, 32 + sf->depth))
+   if (!ps)
       return;
 
+   if (!PUSH_SPACE(push, 32 + sf->depth))
+      goto out;
+
    PUSH_REF1 (push, mt->base.bo, mt->base.domain | NOUVEAU_BO_WR);
 
    if (clear_flags & PIPE_CLEAR_DEPTH) {
@@ -689,6 +701,8 @@ nvc0_clear_depth_stencil(struct pipe_context *pipe,
       IMMED_NVC0(push, NVC0_3D(COND_MODE), nvc0->cond_condmode);
 
    nvc0->dirty_3d |= NVC0_NEW_3D_FRAMEBUFFER;
+out:
+   nv50_surface_destroy(pipe, ps);
 }
 
 void
