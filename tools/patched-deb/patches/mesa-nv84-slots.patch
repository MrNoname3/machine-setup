+/* Waits until the fence of a slot reaches value, as the engines write it; gives
+ * up after two seconds, when the GPU no longer runs. */
+bool
+nv84_decoder_slot_wait(struct nv84_decoder *dec, unsigned slot, uint32_t value)
+{
+   struct nouveau_bo *fence = dec->fence[slot];
+   int64_t end = os_time_get_nano() + 2000000000ll;
+
+   if (nouveau_bo_map(fence, 0, dec->client))
+      return false;
+   while (*(volatile uint32_t *)fence->map < value) {
+      if (os_time_get_nano() > end)
+         return false;
+      os_time_sleep(100);
+   }
+   return true;
+}
