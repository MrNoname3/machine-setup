Description: Zero the VP2 decoder's made-up ring surface before filling it in
 nv84_create_decoder zeroes parts of its H.264 macroblock and VP rings
 through an nv50_surface it fills in over a miptree made up around each
 ring's bo, both on the stack. The clear also reads fields the decoder
 leaves unset, such as the miptree's layer stride, 3D layout and
 multisample mode, so they came from whatever the stack held. Zero the
 miptree and surface before filling them in.
diff --git a/src/gallium/drivers/nouveau/nv50/nv84_video.c b/src/gallium/drivers/nouveau/nv50/nv84_video.c
--- a/src/gallium/drivers/nouveau/nv50/nv84_video.c
+++ b/src/gallium/drivers/nouveau/nv50/nv84_video.c
@@ -482,6 +482,8 @@ nv84_create_decoder(struct pipe_context *context,
        * of doing this... perhaps makes sense to just copy the relevant logic
        * here. */
       color.f[0] = color.f[1] = color.f[2] = color.f[3] = 0;
+      memset(&surf, 0, sizeof(surf));
+      memset(&mip, 0, sizeof(mip));
       surf.offset = dec->frame_size;
       surf.width = 64;
       surf.height = (templ->max_references + 1) * dec->frame_mbs / 4;
