+
+static void
+nv50_clear_render_target(struct pipe_context *pipe,
+                         struct pipe_surface *dst,
+                         const union pipe_color_union *color,
+                         unsigned dstx, unsigned dsty,
+                         unsigned width, unsigned height,
+                         bool render_condition_enabled)
+{
+   /* dst may be a plain template, without nv50_surface's fields. */
+   struct pipe_surface *ps;
+
+   assert(dst->texture->target != PIPE_BUFFER);
+
+   ps = nv50_miptree_surface_new(pipe, dst->texture, dst);
+   if (!ps)
+      return;
+   nv50_clear_render_target_sf(pipe, nv50_surface(ps), color, dstx, dsty,
+                               width, height, render_condition_enabled);
    nv50_surface_destroy(pipe, ps);
 }
 
