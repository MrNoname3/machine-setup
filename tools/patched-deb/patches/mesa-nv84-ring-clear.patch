+/* Clears sf through the 3D engine, with its offset and size as they are. */
+void
+nv50_clear_render_target_sf(struct pipe_context *, struct nv50_surface *sf,
+                            const union pipe_color_union *color,
+                            unsigned dstx, unsigned dsty,
+                            unsigned width, unsigned height,
+                            bool render_condition_enabled);
+
 void
