-      struct iref *ref = &params.ipicparm.refs[i];
+   /* A picture's stored motion vectors name references by their place in
+    * the reference tables, so a reference keeps its place while it is one. */
+   struct nv84_video_buffer *refs[16] = {0};
+   unsigned num_refs, place[16], j;
+
+   for (num_refs = 0; num_refs < 16 && desc->ref[num_refs]; ++num_refs) {
+      struct nv84_video_buffer *frame = (struct nv84_video_buffer *)desc->ref[num_refs];
+      for (j = 0; j < 16 && dec->h264_refs[j] != frame; ++j);
+      place[num_refs] = j;
+      if (j < 16)
+         refs[j] = frame;
+   }
+   for (i = 0; i < num_refs; ++i) {
+      if (place[i] < 16)
+         continue;
+      for (j = 0; refs[j]; ++j);
+      place[i] = j;
+      refs[j] = (struct nv84_video_buffer *)desc->ref[i];
+   }
+   memcpy(dec->h264_refs, refs, sizeof(refs));
+
+   for (i = 0; i < num_refs; i++) {
+      struct iref *ref = &params.ipicparm.refs[place[i]];
       struct nv84_video_buffer *frame = (struct nv84_video_buffer *)desc->ref[i];
-      if (!frame) break;
