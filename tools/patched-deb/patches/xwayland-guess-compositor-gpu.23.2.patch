 {
     struct xwl_gbm_private *xwl_gbm = xwl_gbm_get(xwl_screen);
     drmDevice *main_dev;
 
+    if (xwl_screen->dmabuf_protocol_version < 4) {
+        xwl_gbm->device_name = xwl_glamor_gbm_guess_render_node();
+        if (!xwl_gbm->device_name) {
+            ErrorF("Compositor names no GPU and none could be guessed\n");
+            return FALSE;
+        }
+        ErrorF("Compositor names no GPU, using %s\n", xwl_gbm->device_name);
+        goto open_device;
+    }
+
     while (!xwl_screen->default_feedback.feedback_done) {
