+/*
+ * GF108 in the Acer Aspire 5750G (subsystem 1025:0505): the clock block as the
+ * NVIDIA 390 driver programs it at its three performance levels, which calc_clk()
+ * does not arrive at from the VBIOS clocks.
+ */
+static const struct {
+	u32 reg;
+	u32 val;
+} gf108_clk_const[] = {
+	{ 0x137160, 0x00000003 }, { 0x137168, 0x00000103 }, { 0x13717c, 0x00000103 },
+	{ 0x137184, 0x00000103 }, { 0x137190, 0x00000103 }, { 0x137198, 0x00000103 },
+	{ 0x1371d0, 0x81200606 },
+};
+
+static const struct {
+	u32 reg;
+	u32 val[3];
+} gf108_clk_level[] = {
+	{ 0x137180, { 0x07000103, 0x07000103, 0x07000102 } },
+	{ 0x1371d8, { 0x81200a04, 0x81200404, 0x81200a04 } },
 };
 
+static const struct {
+	u32 reg;
+	u32 val[3];
+} gf108_clk_mdiv[] = {
+	{ 0x137250, { 0x81200006, 0x81200000, 0x81200006 } },
+	{ 0x137258, { 0x81200000, 0x81200000, 0x81200000 } },
+	{ 0x13726c, { 0x8120000a, 0x8120000a, 0x8120000a } },
+	{ 0x137270, { 0x81200004, 0x81200002, 0x81200000 } },
+	{ 0x137274, { 0x81200016, 0x81200006, 0x81200006 } },
+	{ 0x137280, { 0x81200e0e, 0x81200e0e, 0x81200e0e } },
+	{ 0x137288, { 0x81200016, 0x81200006, 0x81200004 } },
+};
+
+/* Each PLL with its reference source and divider, and its coefficients. */
+static const struct {
+	u32 pll, src, div;
+	u32 src_val, div_val, coef;
+} gf108_clk_pll[] = {
+	{ 0x137000, 0x137120, 0x137140, 0x00001003, 0x81200606, 0x00013510 },
+	{ 0x137040, 0x137128, 0x137148, 0x00000103, 0x81200606, 0x00013510 },
+	{ 0x1370e0, 0x13713c, 0x13715c, 0x00000103, 0x81200606, 0x0001250e },
+};
+
+/* Source select (0x137100) at each level, and the order its bits are set in. */
+static const u32 gf108_clk_ssel[3] = { 0x00000000, 0x00000000, 0x00000085 };
+static const u32 gf108_clk_ssel_order[] = { 0x80, 0x04, 0x01 };
+
+static bool
+gf108_clk_board(struct nvkm_device *device)
+{
+	struct pci_dev *pdev;
+
+	if (device->chipset != 0xc1 || !dev_is_pci(device->dev))
+		return false;
+	pdev = to_pci_dev(device->dev);
+	return pdev->subsystem_vendor == 0x1025 && pdev->subsystem_device == 0x0505;
+}
+
+static int
+gf108_clk_ssel_set(struct nvkm_device *device, u32 ssel)
+{
+	nvkm_wr32(device, 0x137100, ssel);
+	if (nvkm_msec(device, 100,
+		if (nvkm_rd32(device, 0x137100) == ssel)
+			break;
+	) < 0)
+		return -ETIMEDOUT;
+	return 0;
+}
+
+static int
+gf108_clk_prog(struct gf100_clk *clk)
+{
+	struct nvkm_device *device = clk->base.subdev.device;
+	const int l = clk->gf108_level;
+	u32 ssel = nvkm_rd32(device, 0x137100);
+	int i, ret;
+
+	/* Every domain onto its divider; hubk01 slowest while its source changes. */
+	nvkm_wr32(device, 0x137270, 0x81200004);
+	for (i = 0; i < ARRAY_SIZE(gf108_clk_const); i++)
+		nvkm_wr32(device, gf108_clk_const[i].reg, gf108_clk_const[i].val);
+	for (i = 0; i < ARRAY_SIZE(gf108_clk_level); i++)
+		nvkm_wr32(device, gf108_clk_level[i].reg, gf108_clk_level[i].val[l]);
+	for (i = ARRAY_SIZE(gf108_clk_ssel_order) - 1; i >= 0; i--) {
+		if (!(ssel & gf108_clk_ssel_order[i]))
+			continue;
+		ssel &= ~gf108_clk_ssel_order[i];
+		if ((ret = gf108_clk_ssel_set(device, ssel)))
+			return ret;
+	}
+	if (ssel && (ret = gf108_clk_ssel_set(device, ssel = 0)))
+		return ret;
+
+	/* PLLs: restarted unless already running and locked as recorded. */
+	for (i = 0; i < ARRAY_SIZE(gf108_clk_pll); i++) {
+		const u32 pll = gf108_clk_pll[i].pll;
+		const bool used = pll != 0x137040 || l == 2;
+
+		if (used &&
+		    (nvkm_rd32(device, pll) & 0x00020005) == 0x00020005 &&
+		    nvkm_rd32(device, pll + 4) == gf108_clk_pll[i].coef &&
+		    nvkm_rd32(device, gf108_clk_pll[i].src) == gf108_clk_pll[i].src_val &&
+		    nvkm_rd32(device, gf108_clk_pll[i].div) == gf108_clk_pll[i].div_val)
+			continue;
+
+		nvkm_wr32(device, pll, 0x00010000);
+		if (!used)
+			continue;
+		nvkm_wr32(device, gf108_clk_pll[i].src, gf108_clk_pll[i].src_val);
+		nvkm_wr32(device, gf108_clk_pll[i].div, gf108_clk_pll[i].div_val);
+		nvkm_wr32(device, pll + 4, gf108_clk_pll[i].coef);
+		nvkm_wr32(device, pll, 0x00010001);
+		if (nvkm_msec(device, 100,
+			if (nvkm_rd32(device, pll) & 0x00020000)
+				break;
+		) < 0)
+			return -ETIMEDOUT;
+		nvkm_wr32(device, pll, 0x00010005);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(gf108_clk_ssel_order); i++) {
+		if (!(gf108_clk_ssel[l] & gf108_clk_ssel_order[i]))
+			continue;
+		ssel |= gf108_clk_ssel_order[i];
+		if ((ret = gf108_clk_ssel_set(device, ssel)))
+			return ret;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(gf108_clk_mdiv); i++)
+		nvkm_wr32(device, gf108_clk_mdiv[i].reg, gf108_clk_mdiv[i].val[l]);
+	return 0;
+}
