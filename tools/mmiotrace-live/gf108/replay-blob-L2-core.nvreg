# Puts the GF108 core clock block into the state the 390 driver keeps at its
# highest performance level (clocks-1.mmio, level 2), from nouveau's boot state
# where every domain runs from its divider (0x137100 == 0). Memory is left alone.

# Start from dividers only.
wait 0x137100 0xffffffff 0x00000000 10

# hubk01 (idx 8): the fixed 100 MHz source, undivided.
w 0x137180 0x07000102
w 0x137270 0x81200002
w 0x137270 0x81200000

# PLL 0x1370e0 (feeds idx 7 and up): coefficients, enable, lock, sync.
w 0x1370e0 0x00010000
w 0x1370e4 0x0001250e
w 0x1370e0 0x00010001
wait 0x1370e0 0x00020000 0x00020000 100
w 0x1370e0 0x00010005

# gpc PLL 0x137000 (idx 0): reference SPPLL0/4, then the same sequence.
w 0x137000 0x00010000
w 0x137120 0x00001003
w 0x137140 0x81200606
w 0x137004 0x00013510
w 0x137000 0x00010001
wait 0x137000 0x00020000 0x00020000 100
w 0x137000 0x00010005

# hubk07 PLL 0x137040 (idx 2).
w 0x137040 0x00010000
w 0x137128 0x00000103
w 0x137148 0x81200606
w 0x137044 0x00013510
w 0x137040 0x00010001
wait 0x137040 0x00020000 0x00020000 100
w 0x137040 0x00010005
w 0x1371d8 0x81200a04

# Source select, in the driver's order: idx 7, then 2, then 0.
w 0x137100 0x00000080
wait 0x137100 0x00000080 0x00000080 100
w 0x137100 0x00000084
wait 0x137100 0x00000084 0x00000084 100
w 0x137100 0x00000085
wait 0x137100 0x00000085 0x00000085 100

# Final dividers.
w 0x137250 0x81200006
w 0x137258 0x81200000
w 0x13726c 0x8120000a
w 0x137274 0x81200006
w 0x137280 0x81200e0e
w 0x137288 0x81200004
