+static int
+gf108_ddr3_calc(struct gf100_ram *ram, u32 freq)
+{
+	struct nvkm_subdev *subdev = &ram->base.fb->subdev;
+	const struct gf108_ddr3_step *step;
+	enum gf108_ddr3_state want;
+	int cur, ret;
+
+	switch (freq) {
+	case 135000: want = GF108_DDR3_135; break;
+	case 324000: want = GF108_DDR3_324; break;
+	case 800000: want = GF108_DDR3_800; break;
+	default:
+		nvkm_error(subdev, "no DDR3 script reaches %d kHz\n", freq);
+		return -EINVAL;
+	}
+
+	cur = gf108_ddr3_state(subdev->device);
+	if (cur < 0) {
+		nvkm_error(subdev, "unknown memory PLL state\n");
+		return cur;
+	}
+
+	ram->ddr3_more = false;
+	if (cur == want || (cur == GF108_DDR3_BOOT && want == GF108_DDR3_324))
+		return 0;
+
+	for (step = gf108_ddr3_steps; step->from != cur; step++)
+		;
+
+	ret = ram_init(&ram->fuc, ram->base.fb);
+	if (ret)
+		return ret;
+
+	nvkm_debug(subdev, "DDR3 script %d -> %d\n", step->from, step->to);
+	gf108_ddr3_script(ram->fuc.base.memx, step->data, step->size);
+	ram->ddr3_more = step->to != want;
+	return 0;
+}
