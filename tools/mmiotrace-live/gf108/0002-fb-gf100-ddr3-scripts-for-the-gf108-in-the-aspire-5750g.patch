+	{ GF108_DDR3_135, GF108_DDR3_800, gf108_ddr3_135_800, ARRAY_SIZE(gf108_ddr3_135_800) },
 };
 
+static bool
+gf108_ddr3_board(struct nvkm_device *device)
+{
+	struct pci_dev *pdev;
+
+	if (device->chipset != 0xc1 || !dev_is_pci(device->dev))
+		return false;
+	pdev = to_pci_dev(device->dev);
+	return pdev->subsystem_vendor == 0x1025 && pdev->subsystem_device == 0x0505;
+}
+
+static int
+gf108_ddr3_state(struct nvkm_device *device)
+{
+	if (!(nvkm_rd32(device, 0x132000) & 0x00000001))
+		return GF108_DDR3_BOOT;
+
+	switch (nvkm_rd32(device, 0x132004)) {
+	case 0x00051806: return GF108_DDR3_324;
+	case 0x00122406: return GF108_DDR3_135;
+	case 0x00032f08: return GF108_DDR3_800;
+	default:
+		return -EINVAL;
+	}
+}
+
+/*
+ * Turns one script into memx commands. Opcode 0x34 has no memx counterpart and
+ * is dropped; 0x3a follows the writes to 0x13d834 and becomes a delay.
+ */
+static void
+gf108_ddr3_script(struct nvkm_memx *memx, const u32 *data, u32 size)
+{
+	u32 wait_data = 0, wait_addr = 0, i, j;
+
+	for (i = 0; i < size; i += data[i] >> 16) {
+		const u32 len = data[i] >> 16, *arg = &data[i + 1];
+
+		if (!len)
+			break;
+
+		switch (data[i] & 0xffff) {
+		case 0x00: wait_data = arg[0]; break;
+		case 0x01: wait_addr = arg[0]; break;
+		case 0x14:
+			if (!arg[0])
+				nvkm_memx_wait_vblank(memx);
+			break;
+		case 0x15: nvkm_memx_wait(memx, wait_addr, arg[0], wait_data, arg[1]); break;
+		case 0x20:
+			if (arg[0])
+				nvkm_memx_block(memx);
+			else
+				nvkm_memx_unblock(memx);
+			break;
+		case 0x21:
+			for (j = 0; j + 2 < len; j += 2)
+				nvkm_memx_wr32(memx, arg[j], arg[j + 1]);
+			break;
+		case 0x2e: nvkm_memx_nsec(memx, arg[0]); break;
+		case 0x3a: nvkm_memx_nsec(memx, arg[0] * 10000); break;
+		default:
+			break;
+		}
+	}
+}
