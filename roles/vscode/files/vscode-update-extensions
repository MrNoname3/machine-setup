#!/bin/sh
# Updates the VS Code extensions that are not pinned, so the terminal's Claude
# Code and Codex, which run from them, stay current while VS Code stays closed.
# The code CLI's own --update-extensions also updates pinned ones. A running
# VS Code updates its extensions itself, so the run is skipped then.
set -eu
if [ -f "$HOME/.vscode/extensions/extensions.json" ]; then
  code=code
  list="$HOME/.vscode/extensions/extensions.json"
elif [ -f "$HOME/.var/app/com.visualstudio.code/data/vscode/extensions/extensions.json" ]; then
  code="flatpak run --command=code com.visualstudio.code"
  list="$HOME/.var/app/com.visualstudio.code/data/vscode/extensions/extensions.json"
else
  exit 0
fi
if pgrep -u "$(id -u)" -x code >/dev/null; then
  echo "VS Code is running and updates its extensions itself"
  exit 0
fi
extensions() {
  python3 -c '
import json, sys
for e in json.load(open(sys.argv[1])):
    if bool(e.get("metadata", {}).get("pinned")) == (sys.argv[2] == "pinned"):
        print(e["identifier"]["id"], e["version"])
' "$list" "$1"
}
set --
for id in $(extensions unpinned | cut -d' ' -f1); do
  set -- "$@" --install-extension "$id"
done
if [ $# -gt 0 ]; then
  # The CLI's own Node deprecation warning says nothing about the extensions.
  NODE_OPTIONS=--no-deprecation $code "$@" --force
fi
# The CLI only marks a replaced version obsolete, for VS Code's next start to
# delete; the ones no process runs from, such as a terminal agent, go now.
python3 -c '
import json, os, shutil, sys
root = sys.argv[1]
mark = os.path.join(root, ".obsolete")
try:
    obsolete = json.load(open(mark))
except FileNotFoundError:
    sys.exit()
used = []
for pid in filter(str.isdigit, os.listdir("/proc")):
    try:
        used.append(os.readlink(f"/proc/{pid}/exe"))
        used += open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0")
    except OSError:
        pass
for name in list(obsolete):
    dirs = {os.path.join(root, name) + "/", os.path.realpath(os.path.join(root, name)) + "/"}
    if any(u.startswith(d) for u in used for d in dirs):
        continue
    shutil.rmtree(os.path.join(root, name), ignore_errors=True)
    del obsolete[name]
    print("Removed the replaced", name)
if obsolete:
    json.dump(obsolete, open(mark, "w"), separators=(",", ":"))
else:
    os.remove(mark)
' "$(dirname "$list")"
extensions pinned | sed 's/^/Pinned, not updated: /'
