#!/usr/bin/env bash
# Remove the images that a newer one of the same repository replaces and no
# container uses, then the dangling ones. Per repository the highest tag stays
# (by version) or, with no tag left, the newest copy; local builds (localhost/)
# are never touched, as they cannot be pulled again. A storage check follows
# where podman has one, so damage shows as a failed unit.
#
#   podman-image-tidy [--dry-run]
set -euo pipefail

dry=0
case "${1:-}" in
  --dry-run) dry=1 ;;
  "") ;;
  *) echo "usage: podman-image-tidy [--dry-run]" >&2; exit 2 ;;
esac

used=" $(podman ps -a --no-trunc --format '{{.ImageID}}' | tr '\n' ' ')"

# One row per name: repository, 1 if tagged, tag, creation (UTC), id. Sorted so
# that each repository's first row is the image that stays.
rows="$(podman images --no-trunc --format '{{.Repository}}|{{.Tag}}|{{.CreatedAt}}|{{.ID}}' |
  awk -F'|' -v OFS='|' '{ sub(/^sha256:/, "", $4); print $1, ($2 != "<none>"), $2, $3, $4 }' |
  sort -t'|' -k1,1 -k2,2r -k3,3Vr -k4,4r)"

# An image stays if it is the first of any repository it is named in, a local
# build, or in use; dangling images are left to the prune below.
keep="$used" repo_seen=" " candidates=""
while IFS='|' read -r repo _ _ _ id; do
  case "$repo" in
    "<none>") continue ;;
    localhost/*) keep="$keep$id " ;;
  esac
  case "$repo_seen" in
    *" $repo "*) candidates="$candidates$id " ;;
    *) repo_seen="$repo_seen$repo " keep="$keep$id " ;;
  esac
done <<<"$rows"

# Remove each name of an image that does not stay; the last one deletes it.
# Without --force, podman refuses a name a container has started using since.
for id in $(tr " " "\n" <<<"$candidates" | sort -u); do
  case "$keep" in *" $id "*) continue ;; esac
  for ref in $(podman image inspect --format '{{range .RepoTags}}{{.}} {{end}}{{range .RepoDigests}}{{.}} {{end}}' "$id"); do
    podman image exists "$id" || break # removing a name before took the image with it
    if [ "$dry" -eq 1 ]; then
      echo "would remove $ref"
    elif podman rmi "$ref" >/dev/null; then
      echo "removed $ref"
    else
      echo "kept $ref: podman could not remove it"
    fi
  done
done

if [ "$dry" -eq 1 ]; then
  podman images --filter dangling=true --format 'would remove dangling {{.ID}}'
  exit 0
fi
podman image prune -f >/dev/null

if podman system check --help >/dev/null 2>&1; then
  podman system check --quick
fi
