#!/bin/sh
# Runs at login (XDG autostart): shows the alerts disk-health-notify recorded
# since this user last saw them, so an alert raised while nobody was logged in
# still reaches someone.
alerts=/var/lib/disk-health/alerts
seen_file=${XDG_STATE_HOME:-$HOME/.local/state}/disk-health/seen
[ -r "$alerts" ] || exit 0

seen=$(cat "$seen_file" 2>/dev/null || echo 0)
new=$(awk -F '\t' -v seen="$seen" '$1 > seen' "$alerts")
[ -n "$new" ] || exit 0

# Give the session's notification daemon time to start.
sleep 15
# Other roles' failures come through disk-health-notify too, so an alert keeps
# its own title.
count=$(printf '%s\n' "$new" | wc -l)
last_title=$(printf '%s\n' "$new" | tail -n 1 | cut -f 2)
last_message=$(printf '%s\n' "$new" | tail -n 1 | cut -f 3)
if [ "$count" -eq 1 ]; then
  title=$last_title body=$last_message
else
  title="$count alerts since your last login" body="Latest: $last_title
$last_message"
fi
notify-send -u critical -i dialog-warning "$title" "$body

All of them: $alerts" || exit 0

mkdir -p "$(dirname "$seen_file")"
date +%s > "$seen_file"
