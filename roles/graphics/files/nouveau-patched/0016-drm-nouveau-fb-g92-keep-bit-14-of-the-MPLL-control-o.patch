From cdfcb840faa88b652ea751eb461ec40fa4d561ae Mon Sep 17 00:00:00 2001
From: Your_Name <you@example.org>
Date: Mon, 19 Oct 2026 20:09:45 +0200
Subject: [PATCH 1/2] drm/nouveau/fb/g92: keep bit 14 of the MPLL control on
 reclock

nv50_ram_calc() clears bit 14 of 0x004008 for the switch and leaves it
clear unless the rammap entry sets rammap_00_16_40. The G92 VBIOS leaves
that rammap bit clear, yet on G92 VRAM loses its contents with bit 14
off: the BAR page tables read back as not present right after the
reclock. The binary driver never touches the bit on G92, so leave it as
the VBIOS set it there.

Assisted-by: Claude:claude-opus-5-5
---
 nvkm/subdev/fb/ramnv50.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/nvkm/subdev/fb/ramnv50.c b/nvkm/subdev/fb/ramnv50.c
index be15519..ee2f9fa 100644
--- a/nvkm/subdev/fb/ramnv50.c
+++ b/nvkm/subdev/fb/ramnv50.c
@@ -230,6 +230,8 @@ nv50_ram_calc(struct nvkm_ram *base, u32 freq)
 	int N1, M1, N2, M2, P;
 	int ret, i;
 	u32 timing[9];
+	/* G92 loses the contents of VRAM when bit 14 of 0x004008 is cleared */
+	bool keep_4008_14 = subdev->device->chipset == 0x92;
 
 	next = &ram->base.target;
 	next->freq = freq;
@@ -350,8 +352,11 @@ nv50_ram_calc(struct nvkm_ram *base, u32 freq)
 	ram_mask(hwsq, 0x00c040, 0xc000c000, 0x0000c000);
 	/* XXX: Is rammap_00_16_40 the DLL bit we've seen in GT215? Why does
 	 * it have a different rammap bit from DLLoff? */
-	ram_mask(hwsq, 0x004008, 0x00004200, 0x00000200 |
-			next->bios.rammap_00_16_40 << 14);
+	if (keep_4008_14)
+		ram_mask(hwsq, 0x004008, 0x00000200, 0x00000200);
+	else
+		ram_mask(hwsq, 0x004008, 0x00004200, 0x00000200 |
+				next->bios.rammap_00_16_40 << 14);
 	ram_mask(hwsq, 0x00400c, 0x0000ffff, (N1 << 8) | M1);
 	ram_mask(hwsq, 0x004008, 0x91ff0000, r004008);
 
@@ -466,7 +471,7 @@ nv50_ram_calc(struct nvkm_ram *base, u32 freq)
 
 	if (next->bios.rammap_00_17_02)
 		ram_mask(hwsq, 0x100200, 0x00000800, 0x00000800);
-	if (!next->bios.rammap_00_16_40)
+	if (!keep_4008_14 && !next->bios.rammap_00_16_40)
 		ram_mask(hwsq, 0x004008, 0x00004000, 0x00000000);
 	if (next->bios.ramcfg_00_03_02)
 		ram_mask(hwsq, 0x10021c, 0x00010000, 0x00010000);
