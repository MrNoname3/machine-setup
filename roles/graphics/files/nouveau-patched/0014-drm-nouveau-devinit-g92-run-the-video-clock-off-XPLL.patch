From 0a957cfc65d15dffdb98351179dc83775bfb5e0c Mon Sep 17 00:00:00 2001
From: Your_Name <you@example.org>
Date: Mon, 19 Oct 2026 14:24:54 +0200
Subject: [PATCH] drm/nouveau/devinit/g92: run the video clock off XPLL

G92 comes out of the VBIOS with the video clock taken from nvclk
divided by two (0xc040 bits 10-11 = 3, 0x4800 divider 1). At the boot
clocks that leaves PVP2 decoding MPEG-2 at a sixth of its rate, and
PBSP's H.264 VLD hangs on its first command, which is why PBSP is
disabled on G92.

NVIDIA's driver switches the video clock to XPLL instead: with the
video clock on the crystal and XPLL's post divider at 0, it programs
XPLL's coefficients, selects the PCIE reference for XPLL (0xc040 bit
25), sets P to 1 and the video divider to 1, and selects XPLL as the
video clock source, with bits 8-9 of 0xc040 set as well. Do the same
at devinit on G92, with N and M from the VBIOS's XPLL limits for
450 MHz.

Assisted-by: Claude:claude-opus-5-5
---
 nvkm/subdev/devinit/g84.c | 48 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 47 insertions(+), 1 deletion(-)

diff --git a/nvkm/subdev/devinit/g84.c b/nvkm/subdev/devinit/g84.c
index 00df781..e68bbd2 100644
--- a/nvkm/subdev/devinit/g84.c
+++ b/nvkm/subdev/devinit/g84.c
@@ -25,6 +25,8 @@
 
 #include <subdev/bios.h>
 #include <subdev/bios/init.h>
+#include <subdev/bios/pll.h>
+#include <subdev/clk/pll.h>
 
 static void
 g84_devinit_disable(struct nvkm_devinit *init)
@@ -48,10 +50,54 @@ g84_devinit_disable(struct nvkm_devinit *init)
 		nvkm_subdev_disable(device, NVKM_ENGINE_CIPHER, 0);
 }
 
+/* G92 comes out of the VBIOS with the video clock, which PVP2 and PBSP run
+ * on, taken from nvclk/2: PVP2 crawls and PBSP's VLD hangs.  Run XPLL off
+ * the PCIE reference instead and take the video clock from it, at the rate
+ * and in the order NVIDIA's driver uses.
+ */
+static void
+g92_devinit_vdec(struct nvkm_devinit *init)
+{
+	struct nvkm_subdev *subdev = &init->subdev;
+	struct nvkm_device *device = subdev->device;
+	struct nvbios_pll pll;
+	int N, M, P;
+
+	if (nvbios_pll_parse(device->bios, 0x004030, &pll)) {
+		nvkm_warn(subdev, "no XPLL limits, video clock left on nvclk\n");
+		return;
+	}
+
+	pll.vco2.max_freq = 0;
+	pll.refclk = 100000; /* the PCIE reference, selected by 0xc040 bit 25 */
+	if (!nv04_pll_calc(subdev, &pll, 450000, &N, &M, NULL, NULL, &P)) {
+		nvkm_warn(subdev, "no XPLL setting, video clock left on nvclk\n");
+		return;
+	}
+
+	nvkm_mask(device, 0x00c040, 0x00000f00, 0x00000200);
+	nvkm_mask(device, 0x004030, 0x003f0000, 0x00000000);
+	nvkm_mask(device, 0x004800, 0x00000700, 0x00000000);
+	nvkm_wr32(device, 0x004034, (N << 8) | M);
+	nvkm_mask(device, 0x00c040, 0x02000000, 0x02000000);
+	nvkm_mask(device, 0x004030, 0x003f0000, (P << 19) | (P << 16));
+	nvkm_mask(device, 0x004800, 0x00000700, 0x00000100);
+	nvkm_mask(device, 0x00c040, 0x00000f00, 0x00000b00);
+	nvkm_debug(subdev, "video clock off XPLL, N %d M %d P %d\n", N, M, P);
+}
+
+static void
+g84_devinit_init(struct nvkm_devinit *init)
+{
+	nv50_devinit_init(init);
+	if (init->subdev.device->chipset == 0x92)
+		g92_devinit_vdec(init);
+}
+
 static const struct nvkm_devinit_func
 g84_devinit = {
 	.preinit = nv50_devinit_preinit,
-	.init = nv50_devinit_init,
+	.init = g84_devinit_init,
 	.post = nv04_devinit_post,
 	.pll_set = nv50_devinit_pll_set,
 	.disable = g84_devinit_disable,
-- 
2.56.0

